# Copy this file to .env and fill it in. Never commit .env.

# From https://developer.spotify.com/dashboard -> your app -> Settings.
# Only the Client ID is needed (login uses PKCE, no client secret).
SPOTIFY_CLIENT_ID=
# Must exactly match a Redirect URI saved in your Spotify app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback

# Optional: Claude vibe matching + smarter mood playlists (needs Python 3.10+).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# How often to check for new liked songs while the app is running (minutes)
SCAN_INTERVAL_MINUTES=60
# The very first check looks this many days back
FIRST_SCAN_DAYS=14
# At most this many playlist suggestions per song (1 or 2)
MAX_PLAYLISTS_PER_SONG=1
# Only suggest a playlist when the fit is at least this good (0-1)
MIN_MATCH_CONFIDENCE=0.7
