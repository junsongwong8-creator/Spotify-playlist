# Copy this file to .env and fill it in. Never commit .env.

# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the Redirect URI saved in your Spotify app exactly
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional but recommended: enables Claude-powered vibe matching and mood curation.
# Get one at https://console.anthropic.com/settings/keys
# Leave blank to use the simpler genre/artist matching instead.
ANTHROPIC_API_KEY=

# How often (minutes) to check Liked Songs for new tracks while the app is running
WATCH_INTERVAL_MINUTES=15
# On the very first scan, look this many days back in your Liked Songs
FIRST_SCAN_DAYS=7
# Only suggest a playlist when the match confidence is at least this (0-1)
MIN_MATCH_CONFIDENCE=0.6
